<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TaskBar+" Width="860" Height="850" MinWidth="820" MinHeight="700" Background="#101318" Foreground="#ECF0F6" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9BA8BA"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#ECF0F6"/><Setter Property="Background" Value="#252C38"/><Setter Property="BorderBrush" Value="#364052"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8EE8C4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8EE8C4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECF0F6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><DockPanel LastChildFill="True"><Border x:Name="Track" DockPanel.Dock="Right" Width="42" Height="24" CornerRadius="12" Background="#404B5C" Margin="18,0,0,0"><Ellipse x:Name="Dot" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="4,0"/></Border><ContentPresenter VerticalAlignment="Center"/></DockPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#6DDCB0"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Dot" Property="Fill" Value="#14251E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#191E27"/><Setter Property="BorderBrush" Value="#2A323F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
  </Window.Resources>
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="TaskBar+" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A little less taskbar. A little more desktop." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="#203C32" CornerRadius="12" Padding="12,5" VerticalAlignment="Top" Margin="8,5,0,0"><TextBlock x:Name="Badge" Text="LIVE" Foreground="#8EE8C4" FontWeight="SemiBold" FontSize="11"/></Border>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel>
        <Border CornerRadius="12" ClipToBounds="True" Height="96" Margin="0,0,0,20">
          <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#344E72"/><GradientStop Color="#355D60" Offset="0.5"/><GradientStop Color="#877464" Offset="1"/></LinearGradientBrush></Grid.Background>
            <TextBlock Text="YOUR DESKTOP, UNINTERRUPTED" FontSize="10" Foreground="#DAE7ED" Margin="17,14" VerticalAlignment="Top"/>
            <Border x:Name="PreviewBar" Height="40" VerticalAlignment="Bottom" Background="#0017202D">
              <Grid><TextBlock Text="⊞" FontSize="22" Margin="14,0" VerticalAlignment="Center"/><StackPanel x:Name="PreviewIcons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="20" Height="20" Background="#70B7E4" CornerRadius="5" Margin="6,0"/><Border Width="20" Height="20" Background="#E5BE72" CornerRadius="5" Margin="6,0"/><Border Width="20" Height="20" Background="#9989E5" CornerRadius="5" Margin="6,0"/><Border Width="20" Height="20" Background="#7ED0B1" CornerRadius="5" Margin="6,0"/></StackPanel><TextBlock Text="12:00" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0" FontSize="11"/></Grid>
            </Border>
            <TextBlock Text="Style preview" FontSize="10" Foreground="#DCE4EB" HorizontalAlignment="Right" Margin="14" VerticalAlignment="Top"/>
          </Grid>
        </Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14" VerticalAlignment="Top"><StackPanel>
          <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Choose how your wallpaper shines through." Style="{StaticResource Caption}" Margin="0,4,0,15"/>
          <UniformGrid Columns="5" Margin="-3,0"><Button x:Name="Clear" Content="Clear" Margin="3,0" Padding="8,10"/><Button x:Name="Blur" Content="Blur" Margin="3,0" Padding="8,10"/><Button x:Name="Acrylic" Content="Acrylic" Margin="3,0" Padding="8,10"/><Button x:Name="Opaque" Content="Solid" Margin="3,0" Padding="8,10"/><Button x:Name="Default" Content="System" ToolTip="Use the Windows default appearance" Margin="3,0" Padding="4,10"/></UniformGrid>
          <Grid Margin="0,19,0,5"><TextBlock Text="Tint opacity"/><TextBlock x:Name="OpacityLabel" Text="0%" HorizontalAlignment="Right" Foreground="#8EE8C4"/></Grid>
          <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="-4,5" AutomationProperties.Name="Tint opacity"/>
          <Grid Margin="0,10,0,0"><TextBlock Text="Tint color" VerticalAlignment="Center"/><Button x:Name="ColorButton" HorizontalAlignment="Right" Padding="12,6"><StackPanel Orientation="Horizontal"><Border x:Name="ColorSwatch" Width="16" Height="16" CornerRadius="4" Background="#17202D" Margin="0,0,8,0"/><TextBlock x:Name="ColorLabel" Text="#17202D" FontSize="12"/></StackPanel></Button></Grid>
          <TextBlock Text="Quick themes" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
          <UniformGrid Columns="4" Margin="-3,0"><Button x:Name="ThemeGlass" Content="Glass" Margin="3,0" Padding="7,8"/><Button x:Name="ThemeFrost" Content="Frost" Margin="3,0" Padding="7,8"/><Button x:Name="ThemeMidnight" Content="Midnight" Margin="3,0" Padding="7,8"/><Button x:Name="ThemeSage" Content="Sage" Margin="3,0" Padding="7,8"/></UniformGrid>
        </StackPanel></Border>
        <StackPanel Grid.Column="1" Margin="7,0,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Layout" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15"/>
          <CheckBox x:Name="CenterToggle" Content="Center app buttons"/><TextBlock Text="Pinned and running apps move together. Start stays in place." Style="{StaticResource Caption}"/>
          <Grid Margin="0,15,0,0"><TextBlock Text="Center offset" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OffsetLabel" Text="0 px" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
          <Slider x:Name="OffsetSlider" Minimum="-200" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Margin="-4,6,0,15" AutomationProperties.Name="Center offset"/>
          <CheckBox x:Name="DisplaysToggle" Content="Apply to all displays"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Everyday essentials" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15"/>
          <CheckBox x:Name="StartupToggle" Content="Start with Windows"/><TextBlock Text="Starts quietly in your system tray when you sign in." Style="{StaticResource Caption}" Margin="0,5,0,18"/>
          <CheckBox x:Name="SecondsToggle" Content="Show seconds in the clock"/><TextBlock Text="Windows applies this clock setting after you sign out and back in." Style="{StaticResource Caption}"/>
        </StackPanel></Border>
        </StackPanel></Grid>
        <TextBlock Text="Changes apply and save automatically. Close this window to keep TaskBar+ running in the tray." Style="{StaticResource Caption}" Margin="2,0,2,16"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,15,0,0">
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="AppVersion" Text="TaskBar+" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatus" Text="Check GitHub for updates when you need them." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button x:Name="UpdateButton" Grid.Column="1" Content="Check for updates" Padding="10,7" FontSize="12" VerticalAlignment="Center"/></Grid>
      <TextBlock x:Name="ResourceUsage" Text="CPU measuring  |  RAM measuring" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/>
      <TextBlock x:Name="Status" Text="Connecting to your taskbar..." Foreground="#8EE8C4" FontSize="12" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PauseButton" Content="Pause"/><Button x:Name="ResetButton" Grid.Column="1" Content="Reset style" Margin="8,0,0,0"/><Button x:Name="HideButton" Grid.Column="3" Content="Keep in tray" Background="#6DDCB0" Foreground="#10231B" BorderBrush="#6DDCB0"/></Grid>
    </StackPanel>
  </Grid>
</Window>
